Import('env', 'envCython', 'arch', 'common', 'messaging', 'cereal')

# native 'can' / 'sendcan' packing and unpacking for card (pandad_api_impl.py falls back to Python without it)
envCython.Program('can_codec_pyx.so', 'can_codec_pyx.pyx', LIBS=envCython["LIBS"] + [cereal, 'capnp', 'kj'])

if arch != "Darwin":
  libs = [common, messaging, 'pthread']
  panda = env.Library('panda', ['panda.cc', 'spi.cc'])

  env.Program('pandad', ['main.cc', 'pandad.cc', 'panda_safety.cc'], LIBS=[panda] + libs)

  if GetOption('extras'):
    env.Program('tests/test_pandad_canprotocol', ['tests/test_pandad_canprotocol.cc'], LIBS=[panda] + libs)
